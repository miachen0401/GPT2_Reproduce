def train(model: nn.Module,
			loader: Dataloader,
			optimizer: torch.optim.Optimizer,
			max_grad_norm: float = 1.0,
			device: torch.device):
	model.train()
	total_loss = 0.0
	num_batch = 0

	for input_ids in loader:
		input_ids = input_ids.to(device）

		optimizer.zero_grad(set_to_none = True)

		logits = model(input_ids)

		loss = F.cross_entropy(
					logits[:, :-1, :].contigious().view(-1, logits.size(-1)),
					input_ids[:, 1:].view(-1))

		loss.backward()
		torch.nn.utils.clip_grad_nrom_(model.parameters(), max_grad_norm)
		optimizer.step()

		num_batch +=1
		total_loss += float(loss.item())

	return total_loss/max(num_batch, 1)



